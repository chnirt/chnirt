{
  "name": "chnirt",
  "private": true,
  "scripts": {
    "postinstall": "npx puppeteer browsers install chrome",
    "pdf:setup": "npx puppeteer browsers install chrome",
    "pdf:resume": "node scripts/build-site.js",
    "pdf:cover": "md-to-pdf COVER_LETTER.md --pdf-options '{\"format\":\"A4\",\"margin\":{\"top\":\"20mm\",\"right\":\"20mm\",\"bottom\":\"20mm\",\"left\":\"20mm\"}}'",
    "pdf": "npm run pdf:resume && npm run pdf:cover",
    "build:site": "node scripts/build-site.js",
    "site": "node scripts/build-site.js",
    "preview": "npx --yes serve docs -p 3456"
  },
  "devDependencies": {
    "html-to-docx": "^1.8.0",
    "marked": "^15.0.12",
    "md-to-pdf": "^2.2.0",
    "puppeteer": "^19.8.0"
  }
}
